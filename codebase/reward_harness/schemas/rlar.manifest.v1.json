        "audit_suite_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Suite Root"
        },
        "audit_required_assurance": {
          "default": "isolated",
          "enum": [
            "static",
            "behavioral_prototype",
            "isolated"
          ],
          "title": "Audit Required Assurance",
          "type": "string"
        },
        "evaluator_integrity_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluator Integrity Env"
        }
      },
      "required": [
        "dev_suite_root",
        "oracle_version"
      ],
      "title": "ValidationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rlar.manifest.v1",
