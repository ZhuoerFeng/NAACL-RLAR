      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/HarnessConfig"
    },
    "config_digest": {
      "title": "Config Digest",
      "type": "string"
    },
    "input_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Path"
    },
    "input_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Digest"
    },
    "input_record_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Record Count"
    },
    "split": {
      "title": "Split",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "deadline_utc": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Deadline Utc"
    },
    "harness_version": {
      "title": "Harness Version",
      "type": "string"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "runner_capabilities": {
      "additionalProperties": true,
      "title": "Runner Capabilities",
      "type": "object"
    },
    "profile_kind": {
      "default": "offline_demo",
      "title": "Profile Kind",
      "type": "string"
    },
    "resolved_paths": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Resolved Paths",
      "type": "object"
    },
    "resource_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Resource Fingerprints",
      "type": "object"
    },
    "initial_library_snapshot": {
