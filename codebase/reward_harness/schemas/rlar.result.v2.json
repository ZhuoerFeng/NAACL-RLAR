{
  "$defs": {
    "ActionOutcome": {
      "enum": [
        "completed",
        "failed",
        "unknown"
      ],
      "title": "ActionOutcome",
      "type": "string"
    },
    "Aggregation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "identity",
            "mean"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Aggregation",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "task_requirement_ref": {
          "minLength": 1,
          "title": "Task Requirement Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "task_requirement_ref"
      ],
      "title": "Capability",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "entrypoint": {
          "const": "score",
          "default": "score",
          "title": "Entrypoint",
          "type": "string"
        },
        "normalization": {
          "$ref": "#/$defs/Normalization"
        },
        "required_apis": {
          "items": {
            "type": "string"
          },
          "title": "Required Apis",
          "type": "array"
        },
        "kind": {
          "enum": [
            "verifiable",
            "rubric"
          ],
          "title": "Kind",
          "type": "string"
        },
        "capability_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Capability Ids",
          "type": "array"
        },
        "judge_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "criterion",
        "source",
        "normalization",
        "kind",
        "capability_ids"
      ],
      "title": "Component",
      "type": "object"
    },
    "ErrorCategory": {
      "enum": [
        "protocol",
        "reward_code",
        "quality",
        "transport",
        "timeout",
        "auth",
        "resource",
        "budget",
        "cancelled",
        "input",
        "internal"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "InputLocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "InputLocation",
      "type": "object"
    },
    "JudgeSpec": {
      "additionalProperties": false,
      "properties": {
        "model_ref": {
          "title": "Model Ref",
          "type": "string"
        },
        "model_config_digest": {
          "title": "Model Config Digest",
          "type": "string"
        },
        "prompt_template": {
          "minLength": 1,
          "title": "Prompt Template",
          "type": "string"
        },
        "output_contract": {
          "minLength": 1,
          "title": "Output Contract",
          "type": "string"
        },
        "parser_entrypoint": {
          "default": "parse_judge",
          "title": "Parser Entrypoint",
          "type": "string"
        }
      },
      "required": [
        "model_ref",
        "model_config_digest",
        "prompt_template",
        "output_contract"
      ],
      "title": "JudgeSpec",
      "type": "object"
    },
    "Normalization": {
      "additionalProperties": false,
      "description": "Frozen mapping of a component's raw score into [0, 1].\n\n``identity`` requires the component to already return a value in [0, 1].\n``mapping`` refers to a mapping declared by the task pack / RM catalogue;\nthe agent may only reference declared mapping IDs, so it cannot smuggle a\nweight in through an arbitrary output scale.",
      "properties": {
        "kind": {
          "enum": [
            "identity",
            "mapping"
          ],
          "title": "Kind",
          "type": "string"
        },
        "range": {
          "default": [
            0.0,
            1.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range",
          "type": "array"
        },
        "mapping_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Normalization",
      "type": "object"
    },
    "RetryOwner": {
      "description": "Who is responsible for making progress after this error.",
      "enum": [
        "agent",
        "harness",
        "none"
      ],
      "title": "RetryOwner",
      "type": "string"
    },
    "RewardDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rlar.reward.v2",
          "default": "rlar.reward.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "single",
            "checklist"
          ],
          "title": "Mode",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "aggregation": {
          "$ref": "#/$defs/Aggregation"
        },
        "runtime_contract": {
          "$ref": "#/$defs/RuntimeContract"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "components",
        "aggregation",
        "capabilities"
      ],
      "title": "RewardDefinition",
      "type": "object"
    },
    "RuntimeContract": {
      "additionalProperties": false,
      "description": "Backend-independent fingerprint of everything that can change scores.",
      "properties": {
        "scoring_abi": {
          "const": "v2",
          "default": "v2",
          "title": "Scoring Abi",
          "type": "string"
        },
        "python_version": {
          "default": "3.11+",
          "title": "Python Version",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "scoring_sdk": {
          "default": "rlar.scoring.v1",
          "title": "Scoring Sdk",
          "type": "string"
        },
        "api_revisions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Api Revisions",
          "type": "object"
        },
        "aggregator_version": {
          "default": "agg.v1",
          "title": "Aggregator Version",
          "type": "string"
        },
        "environment_ref": {
          "default": "configured_at_run_start",
          "title": "Environment Ref",
          "type": "string"
        },
        "reward_logic_policy": {
          "const": "self_contained_v1",
          "default": "self_contained_v1",
          "title": "Reward Logic Policy",
          "type": "string"
        }
      },
      "title": "RuntimeContract",
      "type": "object"
    },
    "StructuredError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "retry_owner": {
          "$ref": "#/$defs/RetryOwner"
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "action_outcome": {
          "$ref": "#/$defs/ActionOutcome",
          "default": "failed"
        },
        "reward_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Key"
        },
        "remaining_budget": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Budget"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "suggested_recovery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Recovery"
        },
        "detail_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail Ref"
        }
      },
      "required": [
        "category",
        "code",
        "phase",
        "retry_owner"
      ],
      "title": "StructuredError",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Cost accounting. ``None`` means unknown; it never means zero.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "unknown_usage_events": {
          "default": 0,
          "title": "Unknown Usage Events",
          "type": "integer"
        },
        "controller_logical_calls": {
          "default": 0,
          "title": "Controller Logical Calls",
          "type": "integer"
        },
        "physical_requests": {
          "default": 0,
          "title": "Physical Requests",
          "type": "integer"
        },
        "transport_retries": {
          "default": 0,
          "title": "Transport Retries",
          "type": "integer"
        },
        "scoring_requests": {
          "default": 0,
          "title": "Scoring Requests",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "component_executions": {
          "default": 0,
          "title": "Component Executions",
          "type": "integer"
        },
        "test_cases": {
          "default": 0,
          "title": "Test Cases",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 0.0,
          "title": "Wall Seconds",
          "type": "number"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "cost_status": {
          "default": "unavailable",
          "enum": [
            "known",
            "unavailable",
            "unknown"
          ],
          "title": "Cost Status",
          "type": "string"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rlar.result.v2",
      "default": "rlar.result.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "input_location": {
      "$ref": "#/$defs/InputLocation"
    },
    "input_digest": {
      "title": "Input Digest",
      "type": "string"
    },
    "run_config_digest": {
      "title": "Run Config Digest",
      "type": "string"
    },
    "library_snapshot": {
      "title": "Library Snapshot",
      "type": "string"
    },
    "job_key": {
      "title": "Job Key",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "integer"
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "stop_reason": {
      "title": "Stop Reason",
      "type": "string"
    },
    "reward_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reward Key"
    },
    "reward_definition": {
      "anyOf": [
        {
          "$ref": "#/$defs/RewardDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Ref"
    },
    "fallback_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Key"
    },
    "trace_ref": {
      "title": "Trace Ref",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "reused": {
      "default": false,
      "title": "Reused",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "query_id",
    "input_location",
    "input_digest",
    "run_config_digest",
    "library_snapshot",
    "job_key",
    "episode_id",
    "attempt_id",
    "status",
    "stop_reason",
    "trace_ref"
  ],
  "title": "ConstructionResult",
  "type": "object",
  "$id": "rlar.result.v2"
}
